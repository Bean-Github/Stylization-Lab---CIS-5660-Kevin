{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "1426af0ff17b4d7faf04a1ba0aa5fbc7",
    "m_Group": {
        "m_Id": "e930cfaafbef499da8ad8550d8e3f940"
    },
    "m_Name": "AdditionalLighting (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": 3055.199951171875,
            "y": 5380.0,
            "width": 258.400390625,
            "height": 189.60009765625
        }
    },
    "m_Slots": [
        {
            "m_Id": "15f6d07c962c48a1b920ccebfb7180c5"
        },
        {
            "m_Id": "05d435e48e9e49f4810163427515d721"
        },
        {
            "m_Id": "095eb005bcc54780a4557f7ce64d25b6"
        },
        {
            "m_Id": "ba951c52c9994dc184242a4daa7e5c79"
        },
        {
            "m_Id": "fc283ba905344c7d9b31222c49129e33"
        },
        {
            "m_Id": "913bc5ca3fda4422bd869ee5ecbf98ff"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "AdditionalLighting",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "    specular = 0;\r\n\r\n    smoothness = exp2(10 * smoothness + 1);\r\n\r\n    normalWS = normalize(normalWS);\r\n    viewWS = normalize(viewWS);\r\n\r\n    // additional lights\r\n    int pixelLightCount = GetAdditionalLightsCount();\r\n    for (int i = 0; i < pixelLightCount; ++i)\r\n    {\r\n        Light light = GetAdditionalLight(i, positionWS);\r\n        float3 attenuatedLight = light.color * light.distanceAttenuation * light.shadowAttenuation;\r\n\r\n        float3 H = normalize(float3(light.direction) + float3(viewWS));\r\n        float NdotH = saturate(dot(normalWS, H));\r\n        float specular_soft = pow(NdotH, smoothness);\r\n        float specular_hard = smoothstep(0.005, 0.01, specular_soft);\r\n        \r\n        float specular_term = lerp(specular_soft, specular_hard, hardness);\r\n\r\n        specular += specular_term * attenuatedLight;\r\n    }"
}

