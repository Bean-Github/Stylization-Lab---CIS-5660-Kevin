{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "0af3a17c2d254a9596f652e708c8abd5",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "ComputeAdditionalLighting (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -2758.68603515625,
            "y": -677.110107421875,
            "width": 310.4000244140625,
            "height": 373.6000061035156
        }
    },
    "m_Slots": [
        {
            "m_Id": "df216c5763924fbaa8ed83f79647b51e"
        },
        {
            "m_Id": "33f5aefbce4f4d6fa5715e394bae03a8"
        },
        {
            "m_Id": "7d94640ce758492b8d4e4114a42f060a"
        },
        {
            "m_Id": "07ac4517f3f24492a6c62e147662531d"
        },
        {
            "m_Id": "467a9ad6ac4a4f2aab5604cff09ffd5b"
        },
        {
            "m_Id": "d7d19a0b7b42476f9276c58a39fc3c76"
        },
        {
            "m_Id": "6bf39ef8edab416fab5c09510b1b508b"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "ComputeAdditionalLighting",
    "m_FunctionSource": "fd67d51a4f7025f4a854ee96dea886d3",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "Diffuse = MainDiffuse;\r\n\r\nColor = MainColor * MainDiffuse;\r\n\r\n\r\n\r\n#ifndef SHADERGRAPH_PREVIEW\r\n\r\n    \r\n\r\n    uint pixelLightCount = GetAdditionalLightsCount();\r\n\r\n\r\n\r\n    #if USE_FORWARD_PLUS\r\n\r\n        InputData inputData = (InputData)0;\r\n\r\n        inputData.normalizedScreenSpaceUV = ScreenPosition;\r\n\r\n        inputData.positionWS = WorldPosition;\r\n\r\n    #endif\r\n\r\n\r\n\r\n    half4 shadowMask = half4(1, 1, 1, 1);\r\n\r\n\r\n\r\n    LIGHT_LOOP_BEGIN(pixelLightCount)\r\n\r\n        #if !USE_FORWARD_PLUS\r\n\r\n            lightIndex = GetPerObjectLightIndex(lightIndex);\r\n\r\n        #endif\r\n\r\nLight light = GetAdditionalLight(lightIndex, WorldPosition, shadowMask);\r\n\r\n        if (light.distanceAttenuation <= 0.0f) continue;\r\n\r\n\r\n\r\n        float NdotL = saturate(dot(WorldNormal, light.direction));\r\n\r\n        float thisDiffuse = light.distanceAttenuation * NdotL;\r\n\r\n        Diffuse += thisDiffuse;\r\n\r\n        Color += light.color * thisDiffuse * light.shadowAttenuation;\r\n\r\n    LIGHT_LOOP_END\r\n\r\n\r\n\r\n#endif\r\n\r\n"
}

